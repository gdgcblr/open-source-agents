# Copy to .env:  cp .env.example .env
# Nothing here is required for: python3 main.py --demo pass --llm none

# LLM: ollama | none
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini

# Routes: bengaluru | fixture | huggingface
ROUTE_PROVIDER=bengaluru
HF_DATASET=

# Policy (optional overrides of policy.yaml)
# POLICY_FILE=policy.yaml
# POLICY_GATES=required_slots,known_places
# POLICY_EVALS=tool_available,tool_faithfulness,goal_alignment
# POLICY_EXTENSIONS=extensions

LOG_LEVEL=info
