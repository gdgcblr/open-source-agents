# Copy to '.env' (cp .env.example .env) and fill in ONE provider's key.
# NEVER commit your real .env file.

# --- LLM provider (pick one; the agent auto-detects whichever key is set) ---
# LLM_PROVIDER=gemini          # gemini | openai | anthropic
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the default model for the chosen provider
# MODEL_NAME=gemini-2.5-flash

# Optional: any OpenAI-compatible server (e.g. Ollama: http://localhost:11434/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Whisper (local speech-to-text) ---
# WHISPER_MODEL=base           # tiny | base | small | medium | large-v3
# WHISPER_DEVICE=cpu           # cpu (default, safest) | cuda | auto (tries GPU, falls back to CPU)
# WHISPER_COMPUTE_TYPE=int8
