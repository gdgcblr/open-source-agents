# Copy to '.env' and adjust. Never commit the real '.env'.

# LiteLLM model id. Two supported setups:
#   Local (no key):  ollama_chat/qwen3.5:9b
#   Gemini free tier: gemini/gemini-3.1-flash-lite (fast) or gemini/gemini-3.6-flash (stronger, 5 requests/min)
MODEL_NAME=ollama_chat/qwen3.5:9b

# Only for gemini/* models. Free key from https://aistudio.google.com/apikey (placeholder below).
GEMINI_API_KEY=

# Where Ollama is listening. Use http://host.docker.internal:11434 when running in Docker.
OLLAMA_API_BASE=http://localhost:11434

# The agent may only read inside this directory (absolute path). Symlink escapes are rejected.
REVIEW_ROOT=/absolute/path/to/repos

# Optional: where GitHub URLs are shallow-cloned (default: <system temp>/oss-adoption-reviewer-clones).
# CLONE_DIR=/absolute/path/to/clones

# Hard cap on LLM calls per review.
MAX_LLM_CALLS=15

# Context window passed to Ollama only (its default is small and can truncate long reviews).
NUM_CTX=16384
