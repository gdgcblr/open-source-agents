# Copy to .env. All settings are optional for local rule-based matching.
# Set a long random key to preserve organizer access across restarts.
# If absent, the server generates a temporary key and prints it locally.
# BUILDBUDDY_ADMIN_KEY=replace-with-a-long-random-secret
# BUILDBUDDY_DB=data/buildbuddy.sqlite3
# Both values are needed to enable Gemini. Choose a model your account supports.
# GEMINI_API_KEY=your-google-ai-studio-api-key
# GEMINI_MODEL=your-supported-gemini-model-id
# Run python setup_model.py once; paste its printed path here for local semantic AI.
# No API key is needed. Inference runs offline on this server.
# BUILDBUDDY_MODEL_DIR=/absolute/path/to/downloaded/model
# Hostnames allowed to serve the app. Add your deployment hostname or LAN IP.
# BUILDBUDDY_ALLOWED_HOSTS=localhost,127.0.0.1
