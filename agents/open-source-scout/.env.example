# ==============================================================================
# OSS Project Scout - Environment Variables
# ==============================================================================
# Copy this file to .env and insert your real tokens.
# NEVER commit your actual .env file into Git!
# ==============================================================================

# GitHub Personal Access Token (PAT) for authenticated search (optional but increases rate limits)
GITHUB_TOKEN=your_github_personal_access_token_here

# Google Gemini API Key for repo summarization (Step 2)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Flask session signing key. Set a unique random value for deployments.
FLASK_SECRET_KEY=

# Local-only defaults. Configure deployment networking and HTTPS separately.
HOST=127.0.0.1
PORT=5050

# Default configuration settings
DEFAULT_TECH_STACK=python
DEFAULT_COMPLEXITY=beginner
TOP_N_REPOS=15
OUTPUT_JSON_PATH=top_15_repos.json
