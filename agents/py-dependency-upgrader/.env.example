# Environment Variable Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env and replace the placeholders with your real values.
# NEVER commit your actual .env file or any secrets to Git.
# -----------------------------------------------------------------------------

# --- Model selection (provider-agnostic) ---
# Set any ADK-supported model identifier.
# Examples:
# MODEL_NAME=gemini-2.5-flash
# MODEL_NAME=openai/gpt-4.1-mini
# MODEL_NAME=anthropic/claude-sonnet-4-6
MODEL_NAME=gemini-2.5-flash

# Set provider credentials required by your selected model.
# Examples (choose only what your model backend needs):
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Application ---
LOG_LEVEL=info
