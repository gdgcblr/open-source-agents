# Environment variables for scam-message-shield
# 1. Copy this file: cp .env.example .env
# 2. Fill in your own values.
# 3. NEVER commit your real .env file.

# Gemini API key from https://aistudio.google.com/app/apikey
# Not needed when running with --no-llm.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: comma-separated Gemini models, tried in order. The -latest aliases track the current model.
# MODEL_NAME=gemini-flash-lite-latest,gemini-flash-latest

# Optional: per-model time limit in milliseconds before falling back to the next model.
# GEMINI_TIMEOUT_MS=45000

# Optional: use Vertex AI instead of an API key (run `gcloud auth application-default login` first).
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
