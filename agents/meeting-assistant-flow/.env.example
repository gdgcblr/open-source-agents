# Google account sign-in and separate Calendar consent. Keep values out of chat/Git.
GOOGLE_CLIENT_CONFIG=credentials.json
FLASK_SECRET_KEY=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/oauth/callback
# Optional: Gemini agenda generation. Manual agendas work without this key.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional: map attendee emails to shared secondary calendars (availability only).
ATTENDEE_CALENDAR_IDS={}
