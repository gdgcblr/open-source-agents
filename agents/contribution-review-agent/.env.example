# Environment variables for contribution-review-agent
# 1. Copy this file: cp .env.example .env
# 2. Fill in your own values.
# 3. NEVER commit your real .env file.

# Gemini API key from https://aistudio.google.com/app/apikey
# Not needed when running with --no-llm.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model used for the AI review.
# MODEL_NAME=gemini-flash-lite-latest

# Optional: GitHub token (no scopes needed for public repos).
# Raises the GitHub API rate limit from 60 to 5,000 requests/hour when reviewing PRs.
# GITHUB_TOKEN=your_github_token_here

# Optional: use Vertex AI instead of an API key (run `gcloud auth application-default login` first).
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
