# Environment Variable Configuration Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Replace placeholder values with your own credentials.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# --- Gemini / Google AI Studio ---
# Required only for the ADK agent layer (Layer 2).
# Layer 1 CLI works with NO API key.
GOOGLE_API_KEY=your_google_api_key_here

# --- Model Settings ---
# Default model used by the ADK agent. Falls back to gemini-2.0-flash
# if gemini-2.5-flash is unavailable for your key.
MODEL_NAME=gemini-2.5-flash

# --- GitHub API (optional, for the triage subcommand) ---
# Without a token: 60 req/hr. With a token: 5000 req/hr.
# Read-only. Never required — triage works anonymously but may rate-limit.
GITHUB_TOKEN=your_github_token_here
