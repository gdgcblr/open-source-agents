{
  "name": "contribution-review-agent",
  "version": "0.1.0",
  "description": "Google ADK agent that reviews submissions to the open-source-agents repository and returns a scored compliance report.",
  "type": "module",
  "main": "src/agent.ts",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "review": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "chat": "adk run src/agent.ts",
    "web": "adk web src/agent.ts"
  },
  "dependencies": {
    "@google/adk": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@google/adk-devtools": "^2.3.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
