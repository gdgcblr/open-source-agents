# RunReady — environment configuration template
# -----------------------------------------------------------------------------
# 1. Copy this file to `.env`:  cp .env.example .env
# 2. Fill in your own Gemini (Google AI Studio) API key below.
# 3. NEVER commit your real `.env` — it is git-ignored by this project.
#
# RunReady's deterministic safety core (diagnosis, patch validation, approval,
# py_compile/import checks, the full test suite) runs WITHOUT any key. A key is
# only needed for the optional Gemini narrative in `python main.py` and for
# `adk web` / `adk run`.
# -----------------------------------------------------------------------------

# Required for the Gemini-backed narrative and the ADK web/run UIs.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Use Google AI Studio (not Vertex AI). Leave as FALSE for the AI Studio key above.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional: override the Gemini model. Defaults to gemini-2.5-flash in code.
# GEMINI_MODEL=gemini-2.5-flash
