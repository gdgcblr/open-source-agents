# MeetingMind AI — Environment Variable Configuration
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Fill in the values below.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# --- Open-Source Gemma & LLM Inference Settings ---
# Ollama endpoint (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Gemma model identifier (e.g., gemma2:9b, gemma2:27b, gemma:2b)
GEMMA_MODEL=gemma2:9b

# (Optional) Remote vLLM or Hugging Face TGI OpenAI-compatible endpoint
VLLM_BASE_URL=
VLLM_API_KEY=

# --- Google Workspace OAuth 2.0 Credentials ---
# Required for Chrome Identity API and Google Drive, Calendar, Gmail integration
# Create a Web/Chrome Application Client ID in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Server & Persistence Settings ---
HOST=0.0.0.0
PORT=8000
DB_PATH=./meetingmind.db

# Grace period in hours before nudging user via email if an action item lacks a deadline
NUDGE_GRACE_HOURS=2
