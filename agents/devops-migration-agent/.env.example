# Google AI / Gemini API Credentials
GOOGLE_API_KEY=your_gemini_api_key_here

# Model Selection (defaults to gemini-2.5-flash)
MODEL_NAME=gemini-2.5-flash

# Vertex AI Settings (Optional alternative to API Key)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Agent Execution Mode
OFFLINE_MODE=false
VERBOSE=false
LOG_LEVEL=INFO

# Azure DevOps Default Settings
AZURE_SERVICE_CONNECTION=azure-service-connection
DEFAULT_VM_IMAGE=ubuntu-latest
MIGRATION_OUTPUT_DIR=./migration-output
