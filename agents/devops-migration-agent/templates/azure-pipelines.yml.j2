# Azure DevOps Pipeline generated by DevOps Migration Agent
# Source: {{ workflow.file_path or 'GitHub Actions' }}
# Generated automatically. Review tasks, service connections, and secrets before execution.

{% if pipeline_name %}
name: {{ pipeline_name }}
{% endif %}

{% if triggers.push %}
trigger:
  {% if triggers.push.branches %}
  branches:
    include:
      {% for b in triggers.push.branches %}
      - {{ b }}
      {% endfor %}
  {% else %}
  branches:
    include:
      - '*'
  {% endif %}
  {% if triggers.push.tags %}
  tags:
    include:
      {% for t in triggers.push.tags %}
      - {{ t }}
      {% endfor %}
  {% endif %}
  {% if triggers.push.paths %}
  paths:
    include:
      {% for p in triggers.push.paths %}
      - {{ p }}
      {% endfor %}
  {% endif %}
  {% if triggers.push.paths_ignore %}
    exclude:
      {% for p in triggers.push.paths_ignore %}
      - {{ p }}
      {% endfor %}
  {% endif %}
{% else %}
trigger: none
{% endif %}

{% if triggers.pull_request %}
pr:
  {% if triggers.pull_request.branches %}
  branches:
    include:
      {% for b in triggers.pull_request.branches %}
      - {{ b }}
      {% endfor %}
  {% else %}
  branches:
    include:
      - '*'
  {% endif %}
  {% if triggers.pull_request.paths %}
  paths:
    include:
      {% for p in triggers.pull_request.paths %}
      - {{ p }}
      {% endfor %}
  {% endif %}
{% else %}
pr: none
{% endif %}

{% if triggers.schedule and triggers.schedule.cron %}
schedules:
  {% for cron_expr in triggers.schedule.cron %}
  - cron: '{{ cron_expr }}'
    displayName: 'Scheduled Run ({{ cron_expr }})'
    branches:
      include:
        - main
    always: true
  {% endfor %}
{% endif %}

{% if variables or secret_vars %}
variables:
  {% for k, v in variables.items() %}
  - name: {{ k }}
    value: '{{ v }}'
  {% endfor %}
  {% if secret_vars %}
  # Note: Azure DevOps pipeline variables or Azure Key Vault Variable Group recommended for secrets:
  # - group: 'devops-secrets'
  {% for s in secret_vars %}
  # - name: {{ s }} (Configure in Pipeline Variables or KeyVault)
  {% endfor %}
  {% endif %}
{% endif %}

jobs:
{% for job in jobs %}
- job: {{ job.id | replace('-', '_') }}
  displayName: '{{ job.display_name }}'
  {% if job.dependsOn %}
  dependsOn:
    {% for dep in job.dependsOn %}
    - {{ dep | replace('-', '_') }}
    {% endfor %}
  {% endif %}
  {% if job.condition %}
  condition: {{ job.condition }}
  {% endif %}
  {% if job.strategy and job.strategy.matrix %}
  strategy:
    matrix:
      {% for m_name, m_vals in job.strategy.matrix.items() %}
      {{ m_name }}:
        {% for mk, mv in m_vals.items() %}
        {{ mk }}: '{{ mv }}'
        {% endfor %}
      {% endfor %}
  {% endif %}
  pool:
    vmImage: '{{ job.vmImage }}'
  {% if job.timeoutInMinutes %}
  timeoutInMinutes: {{ job.timeoutInMinutes }}
  {% endif %}
  steps:
    {% for step in job.steps %}
    {% if step.type == 'checkout' %}
    - checkout: {{ step.checkout }}
      {% if step.clean is defined and step.clean is not none and step.clean != '' %}
      clean: {{ step.clean | lower }}
      {% endif %}
      {% if step.fetchDepth is defined and step.fetchDepth is not none and step.fetchDepth != '' %}
      fetchDepth: {{ step.fetchDepth }}
      {% endif %}
      {% if step.submodules %}
      submodules: {{ step.submodules }}
      {% endif %}
      {% if step.lfs %}
      lfs: {{ step.lfs | lower }}
      {% endif %}
    {% elif step.type == 'task' %}
    - task: {{ step.task }}
      displayName: '{{ step.displayName }}'
      {% if step.inputs %}
      inputs:
        {% for ik, iv in step.inputs.items() %}
        {{ ik }}: {{ iv | to_yaml_val }}
        {% endfor %}
      {% endif %}
      {% if step.env %}
      env:
        {% for ek, ev in step.env.items() %}
        {{ ek }}: '{{ ev }}'
        {% endfor %}
      {% endif %}
      {% if step.condition %}
      condition: {{ step.condition }}
      {% endif %}
      {% if step.continueOnError %}
      continueOnError: true
      {% endif %}
    {% elif step.type == 'script' %}
    - {{ step.script_type }}: |
        {{ step.script | indent_lines(8) }}
      displayName: '{{ step.displayName }}'
      {% if step.env %}
      env:
        {% for ek, ev in step.env.items() %}
        {{ ek }}: '{{ ev }}'
        {% endfor %}
      {% endif %}
      {% if step.condition %}
      condition: {{ step.condition }}
      {% endif %}
      {% if step.continueOnError %}
      continueOnError: true
      {% endif %}
    {% elif step.type == 'manual_placeholder' %}
    - script: |
        echo "##[warning] Manual migration required for: {{ step.action_name }}"
        echo "{{ step.explanation | replace('"', '\\"') | replace('\n', ' ') }}"
      displayName: '[MANUAL] {{ step.displayName }}'
    {% endif %}
    {% endfor %}
{% endfor %}
