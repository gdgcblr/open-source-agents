# ==============================================================================
# Bharat Dues Audit Agent Environment Configuration
# Copy this file to .env before starting:
#   cp .env.example .env
# ==============================================================================

# Google Gemini API Key (Get a free key at https://aistudio.google.com/app/apikey)
# NOTE: Can also be configured directly in the web browser UI via "🔑 Configure API Key"!
# If left empty, the agent runs in Zero-Key Resilient Deterministic Mode ($0.00 cost, offline-ready).
GEMINI_API_KEY=

# Active Recommended Models (Selectable in Web UI):
# - gemini-2.5-flash        (Recommended Default: Multimodal OCR, low latency, 1M context)
# - gemini-2.5-pro          (Deep multi-step reasoning, complex dispute resolution)
# - gemini-2.5-flash-lite   (Lightweight, high-speed extraction)
# - gemini-1.5-flash        (Long-Term Support LTS general purpose workhorse)
# - gemini-1.5-pro          (Long-Term Support LTS reasoning, 2M context)
# - gemma-2-9b-it           (Google DeepMind open weights)
#
# DEPRECATED MODELS (DO NOT USE - SHUT DOWN BY GOOGLE):
# - gemini-1.0-pro / gemini-pro (DEPRECATED)
# - gemini-pro-vision / gemini-1.0-pro-vision (SHUT DOWN - use gemini-2.5-flash)
# - gemini-1.0-ultra (DEPRECATED)
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Currency Symbol
DEFAULT_CURRENCY=INR
