# ==============================================================================
# Gemini Audit Agent Environment Configuration
# Copy this file to .env before starting:
#   cp .env.example .env
# ==============================================================================

# Google Gemini API Key (Free tier available at https://aistudio.google.com/app/apikey)
# If left empty, the agent automatically runs in Offline Heuristic / Mock Mode
GEMINI_API_KEY=

# Model Configuration
GEMINI_MODEL=gemini-1.5-flash

# Server Configuration
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Currency Symbol
DEFAULT_CURRENCY=INR
