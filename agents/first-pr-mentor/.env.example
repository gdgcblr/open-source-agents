# first-pr-mentor configuration
# -----------------------------------------------------------------------------
# 1. Copy this file to '.env' in this folder:  cp .env.example .env
# 2. Fill in your own keys below.
# 3. NEVER commit your '.env' file. It is already listed in .gitignore.
# -----------------------------------------------------------------------------

# Required for `learn` / `explain` / `start`.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Default: gemini-3.8-flash. A cheaper/faster option: gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.8-flash

# Strongly recommended. Without it GitHub allows only 60 requests/hour,
# which is about one `find` run.
# Create a fine-grained token with NO extra permissions (public repos, read-only):
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=your_read_only_github_token_here
