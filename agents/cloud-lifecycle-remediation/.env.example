# --- LLM provider (pick one) ---
# openai | gemini — if unset, uses OpenAI when OPENAI_API_KEY is set, else Gemini
LLM_PROVIDER=openai

# OpenAI Platform API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Google AI Studio / Gemini (when LLM_PROVIDER=gemini)
# GOOGLE_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Model id for the selected provider
MODEL_NAME=gpt-4o-mini

# When true, skip git push and gh pr create (local demo)
SIMULATE_PR=true
