# Environment Variable Configuration Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' in your project directory: cp .env.example .env
# 2. Replace the placeholder values below with your own valid credentials.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# --- Model & API Providers ---
# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Model Settings ---
# Model identifier for Gemini function calling (e.g., gemini-2.5-flash, gemini-2.5-pro)
MODEL_NAME=gemini-2.5-flash

# --- Safety & Execution Controls ---
# Maximum autonomous reasoning loop iterations before halting or escalating
MAX_ITERATIONS=10

# Maximum tool calls per incident lifecycle
MAX_TOOL_CALLS=15

# Timeout in seconds for individual model reasoning and tool executions
OPERATION_TIMEOUT_SECONDS=35.0

# Logging verbosity (debug, info, warn, error)
LOG_LEVEL=info
