# Environment Variable Configuration Template — MergeMesh
# -----------------------------------------------------------------------------
# Instructions:
# 1. MergeMesh runs out-of-the-box in local-first mode with NO API keys or credits.
# 2. Optionally copy this file to '.env' in agents/mergemesh/: cp .env.example .env
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# --- AI & Execution Mode (Local-First Runtime) ---
# Supported active modes:
#   local         -> Local Gemma via Ollama + Google ADK LiteLLM (auto-falls back to deterministic engine if Ollama is offline)
#   gemini        -> Hosted Google Gemma via Gemini Developer API + Google ADK LiteLLM (requires GEMINI_API_KEY)
#   deterministic -> Pure deterministic Python AST & contract engine (zero LLM calls)
MERGEMESH_AI_MODE=local

# --- Local Model Runtime (Ollama) ---
# Preferred local reasoning model: gemma4:e4b (or gemma4:e2b for lower VRAM/RAM, or gemma3:4b)
# Pull the model locally when desired: ollama pull gemma4:e4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# When true (default), if Ollama is stopped or the local model is not downloaded,
# MergeMesh preserves all deterministic findings and test outputs and displays
# a clearly labelled deterministic fallback explanation.
ALLOW_LOCAL_FALLBACK=true

# --- Operational & Safety Timeouts ---
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_CALLS_PER_ANALYSIS=2
TEST_RUNNER_TIMEOUT_SECONDS=15

# --- Optional Hosted Google Gemma / Gemini API Settings (MERGEMESH_AI_MODE=gemini) ---
# Official supported hosted Gemma 4 model IDs on Google Gemini API:
#   gemma-4-26b-a4b-it (default) or gemma-4-31b-it
GEMINI_MODEL=gemma-4-26b-a4b-it
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_BACKEND=developer_api
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
# GOOGLE_CLOUD_LOCATION=us-central1
