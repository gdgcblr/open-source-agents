# QuickCart Advisor — Environment Configuration
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Fill in the values you need; defaults work out of the box for a local
#    LM Studio setup.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# --- LLM Backend Selection ---
# "openai" (default) = any OpenAI-compatible Chat Completions server
#                      (e.g. LM Studio) via ADK-Go openaimodel.APIChatCompletions
# "gemini"           = Google Gemini API via the genai client
LLM_BACKEND=openai

# --- OpenAI-compatible backend (LLM_BACKEND=openai, e.g. LM Studio) ---
# LM Studio serving the model on its local server (Chat Completions endpoint):
OPENAI_BASE_URL=http://localhost:1235/v1
# Model identifier as loaded in LM Studio:
OPENAI_MODEL=google/gemma-4-12b
# Local servers accept any non-empty placeholder; a real key only if your
# server enforces one:
OPENAI_API_KEY=local

# --- Gemini backend (LLM_BACKEND=gemini) ---
# Google AI Studio API key — required for the gemini backend:
# GOOGLE_API_KEY=your_google_ai_studio_api_key_here
# With --backend gemini and OPENAI_MODEL unset, the model defaults to
# "gemini-flash-latest"; set OPENAI_MODEL (or --model) to override.

# --- Offers data source (Phase 1: offline demo catalog always-on) ---
# OFFLINE_DEMO=true (default) forces the bundled offline demo catalog for ALL
# four retailers and skips live adapters: deterministic, zero network, ideal
# for local demos. Set OFFLINE_DEMO=false together with QBUYS_BASE_URL to opt
# into live data for the three quick-commerce sites (best-effort; falls back to
# the demo catalog when unreachable, never presented as live prices).
OFFLINE_DEMO=true
# Optional live adapter: open-source qbserver / qbuys-server covering Swiggy
# Instamart, Blinkit and Zepto. Amazon India is NOT covered by qbuys. Leave
# empty (with OFFLINE_DEMO=true) for a fully-offline demo.
# QBUYS_BASE_URL=http://localhost:8080

# --- Phase 2 (roadmap) ---
# Real Internet data and/or MCP (Model Context Protocol) servers will replace /
# augment the demo catalog with live prices. Placeholders, not yet used:
# MCP_RETAILERS_SERVERS=
# LIVE_WEB_SOURCES=
