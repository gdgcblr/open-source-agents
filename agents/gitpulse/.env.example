# Environment Variable Configuration Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' in your project directory: cp .env.example .env
# 2. Replace the placeholder values below with your own valid credentials.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# Optional local Gemma model served by Ollama. No API key is required.
GITPULSE_MODEL=gemma3:4b
OLLAMA_API_BASE=http://localhost:11434

# Optional Gemini API mode. This sends redacted diffs to Google's Gemini API.
GEMINI_API_KEY=your_actual_key_here
GITPULSE_API_MODEL=gemini-3.5-flash-lite
