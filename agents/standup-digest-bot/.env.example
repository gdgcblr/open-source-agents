# ---------------------------------------------------------------------------
# standup-digest-bot configuration (copy to .env and fill in)
# ---------------------------------------------------------------------------

# --- LLM provider selection -------------------------------------------------
# One of: ollama | gemini | openai | mock
# Default is "ollama" (fully local, no API key required).
LLM_PROVIDER=ollama

# Model identifier for the chosen provider.
#   ollama -> e.g. llama3.1, qwen2.5, mistral
#   gemini -> e.g. gemini-2.5-flash
#   openai -> e.g. gpt-4o-mini
LLM_MODEL=llama3.1

# Base URL for a local Ollama server (only used when LLM_PROVIDER=ollama).
OLLAMA_BASE_URL=http://localhost:11434

# Read timeout (seconds) for Ollama generation. Raise this for large models on
# CPU-only machines where the first call is slow. Default: 600.
OLLAMA_TIMEOUT=600

# API keys (ONLY required for the matching hosted provider). Leave blank otherwise.
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- GitHub tool ------------------------------------------------------------
# Personal Access Token (classic or fine-grained) with 'repo' + read scopes.
# Required for private repos and to avoid low unauthenticated rate limits.
# Leave blank to run against public data only (subject to strict rate limits).
GITHUB_TOKEN=

# GitHub username whose activity will be summarized (defaults to the token owner).
GITHUB_USERNAME=

# --- Behavior ---------------------------------------------------------------
# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info
