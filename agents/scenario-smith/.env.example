# Google AI Studio key for Gemini. Never commit real credentials.
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Required when using GitHub issue/repository tools (public or private repositories).
# Use a fine-grained PAT restricted to only the repositories ScenarioSmith should read.
# Grant Contents: Read-only and Issues: Read-only. Never commit the real token.
GITHUB_PERSONAL_ACCESS_TOKEN=your_fine_grained_github_pat_here
