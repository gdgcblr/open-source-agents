# Copy to .env and fill in. NEVER commit your real .env file.

# Gemini API keys from https://aistudio.google.com/apikey (free tier available).
# Without a key, the app still works using the built-in rule engine (text only).
# Leave empty to run in rules-only mode (any non-empty value turns AI mode on).
#
# GOOGLE_API_KEYS takes any number of comma-separated keys, for example
#   GOOGLE_API_KEYS=key_one,key_two,key_three
# If a key is invalid, over quota or unreachable, the server moves on to the next.
# Create each key in a DIFFERENT Google Cloud project: free-tier quota is per
# project, so keys from the same project run out together and are no backup.
GOOGLE_API_KEYS=
# Older setting, still supported (one key or a comma-separated list, used after GOOGLE_API_KEYS).
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Fast, low-cost model. Any Gemini model that supports tools + structured output works.
MODEL_NAME=gemini-3.5-flash-lite

# Server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=20
