# Copy to .env and fill in. NEVER commit .env.
# The CLI and ADK read real environment variables, so also `export` these (see README).

# --- Needed only for the ADK agent, or the CLI without --mock ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Leave empty: the agent copies GEMINI_API_KEY into this (ADK reads GOOGLE_API_KEY)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Safety and limits (defaults shown) ---
# Directory the agent's tools may read
TRIAGE_ROOT=.
# Per-request budgets for the ADK agent
TRIAGE_MAX_MODEL_CALLS=8
TRIAGE_MAX_TOOL_CALLS=12

# --- Privacy ---
# Comma-separated names, customers or codenames to treat as PII (patterns cannot find these)
TRIAGE_REDACT_TERMS=
