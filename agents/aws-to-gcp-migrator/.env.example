# Environment Variable Configuration for aws-to-gcp-migrator
# -----------------------------------------------------------------------------
# Copy this file to '.env': cp .env.example .env
# NEVER commit your actual '.env' file containing real secrets.
# -----------------------------------------------------------------------------

# Google AI Studio API Key (Free tier from https://aistudio.google.com/)
# Note: If omitted, the agent will run in offline / mock mode automatically.
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier (e.g. gemini-2.5-flash, gemini-1.5-flash)
MODEL_NAME=gemini-2.5-flash

# Target Google Cloud Configuration
GCP_PROJECT_ID=my-gcp-project
GCP_REGION=us-central1
