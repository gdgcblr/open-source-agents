# Copy this file to '.env' in this directory: cp .env.example .env
# NEVER commit your real '.env' file.

# Use a Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: model to use (must support image input)
# MODEL_NAME=gemini-3.5-flash

# Optional: where save_complaint writes drafts (default: ./complaints)
# COMPLAINTS_DIR=./complaints
