# Google AI Studio API key used by the Gemini model.
# Never commit the real value.
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Optional model override.
MODEL_NAME=gemini-2.5-flash

# Optional smaller explanation model. Use only when your ADK model provider
# exposes Gemma 3 4B with this identifier; deterministic tools remain authoritative.
# MODEL_NAME=gemma-3-4b-it
