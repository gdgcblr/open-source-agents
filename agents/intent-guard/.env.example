# Environment Variable Configuration
# -----------------------------------------------------------------------------
# 1. Copy this file to '.env': cp .env.example .env
# 2. Replace placeholder values with your own credentials.
# 3. NEVER commit your actual '.env' file to Git.
# -----------------------------------------------------------------------------

# --- Google Gemini API Key (Required) ---
# Both GEMINI_API_KEY and GOOGLE_API_KEY are supported
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# --- Model Settings ---
# Recommended models: gemini-3.5-flash (fast, standard) or gemini-3.8-flash (deep reasoning)
MODEL_NAME=gemini-3.5-flash

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
