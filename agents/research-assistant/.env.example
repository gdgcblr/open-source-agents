# Research Assistant Environment Variables
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' in this directory:
#    cp .env.example .env (Linux/macOS) or Copy-Item .env.example -Destination .env (Windows)
# 2. Fill in your Gemini API key (obtain free at https://aistudio.google.com).
# 3. DO NOT commit your actual '.env' file to Git.
# -----------------------------------------------------------------------------

# Primary LLM API Key (Required for live mode, or use --mock for offline mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
MODEL_NAME=gemini-2.5-flash

# Research Agent Parameters
MAX_RESEARCH_STEPS=5
SEARCH_MAX_RESULTS=5
SCRAPE_MAX_CHARS=4000
OUTPUT_DIR=reports
LOG_LEVEL=info
