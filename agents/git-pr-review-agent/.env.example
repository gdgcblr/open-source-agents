# Git PR Review Agent Environment Variables
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Add your Gemini API key (or leave empty to use local Ollama / Mock mode)
# 3. NEVER commit your actual .env file to Git!
# -----------------------------------------------------------------------------

# Google Gemini API Key (get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider selection: 'gemini', 'ollama', or 'mock' (default: auto-detected)
LLM_PROVIDER=gemini

# Model name:
# For Gemini: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
# For Ollama: gemma2:2b, llama3.2:3b
MODEL_NAME=gemini-2.5-flash

# Ollama local endpoint (if using local offline models)
OLLAMA_BASE_URL=http://localhost:11434

# Web Server Configuration (when running with --serve)
PORT=8000
HOST=0.0.0.0
