# Cursor Agent SDK — required for official `agent-sdk run` / `agent-sdk eval`
# Create at https://cursor.com/settings or run: npx @grok/agent-sdk login
CURSOR_API_KEY=your_cursor_api_key_here

# Optional: NVIDIA integrate API — for scripts/nvidia_smoke.py only (not agent-sdk eval)
# NVIDIA_API_KEY=your_nvidia_api_key_here
# NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=z-ai/glm-5.3

# Optional: OpenTelemetry (see Agent SDK docs)
# OTEL_EXPORTER_OTLP_ENDPOINT=
