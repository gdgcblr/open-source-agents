# Cursor Agent SDK — required for official `agent-sdk run` / `agent-sdk eval`
# Create at https://cursor.com/settings or run: npx @grok/agent-sdk login
CURSOR_API_KEY=your_cursor_api_key_here

# Generic smoke test (scripts/smoke_test.py) — works with any OpenAI-compatible provider
# SMOKE_API_KEY=your_api_key_here
# SMOKE_BASE_URL=https://api.openai.com/v1         # default; override for other providers
# SMOKE_MODEL=gpt-4o-mini                          # default; override for other models
#
# Examples:
#   NVIDIA integrate endpoint:
#     SMOKE_BASE_URL=https://integrate.api.nvidia.com/v1
#     SMOKE_MODEL=z-ai/glm-5.3
#
#   Anthropic (via OpenAI-compatible proxy):
#     SMOKE_BASE_URL=https://api.anthropic.com/v1
#     SMOKE_MODEL=claude-3-haiku-20240307

# Optional: OpenTelemetry (see Agent SDK docs)
# OTEL_EXPORTER_OTLP_ENDPOINT=
