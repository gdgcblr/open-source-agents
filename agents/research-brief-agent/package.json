{
  "name": "research-brief-agent",
  "private": true,
  "type": "module",
  "description": "agent project: research-brief-agent",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "agent-sdk dev",
    "tool:list-sources": "agent-sdk tool call list-bundled-sources --dir . --input \"{}\" --json",
    "tool:read-fixture": "agent-sdk tool call read-bundled-source --dir . --input \"{\\\"filename\\\":\\\"healthcare-edge.md\\\"}\" --json",
    "fixture:save": "node -e \"require('fs').mkdirSync('.agent-serve',{recursive:true})\" && npm run tool:read-fixture > .agent-serve/nvidia-fixture.json"
  },
  "dependencies": {
    "@grok/agent-sdk": "^0.2.29",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "6.0.3"
  }
}
