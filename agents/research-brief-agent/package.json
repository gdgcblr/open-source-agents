{
  "name": "research-brief-agent",
  "private": true,
  "type": "module",
  "description": "agent project: research-brief-agent",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "agent-sdk dev",
    "tool:list-sources": "agent-sdk tool call list-bundled-sources --dir . --input \"{}\" --json",
    "tool:read-fixture": "agent-sdk tool call read-bundled-source --dir . --input \"{\\\"filename\\\":\\\"healthcare-edge.md\\\"}\" --json",
    "fixture:save": "python scripts/save_fixture.py",
    "smoke": "python scripts/smoke_test.py --fixture-json .agent-serve/fixture.json",
    "demo": "python scripts/generate_report.py --topic \"Edge Computing in Healthcare\"",
    "demo:url": "python scripts/generate_report.py --topic \"AI Agents in Drug Discovery\" --url \"https://en.wikipedia.org/wiki/Drug_discovery\""
  },
  "dependencies": {
    "@grok/agent-sdk": "^0.2.29",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "6.0.3"
  }
}
