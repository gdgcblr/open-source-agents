# --- Google model access (choose ONE) ---------------------------------------
# Option A: Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key-here

# Option B: Vertex AI instead of an API key (leave GOOGLE_API_KEY empty and
# authenticate with `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Agent -------------------------------------------------------------------
# Gemini model used by the agent (must be supported by your installed ADK version)
AGENT_MODEL=gemini-flash-latest
# How many times an identical failing tool call may be retried (enforced)
AGENT_MAX_RETRIES=2
# Hard cap on tool calls per user request (enforced)
AGENT_MAX_TOOL_CALLS=40
# Logging: DEBUG, INFO, WARNING. Typed text is hidden in logs unless enabled.
AGENT_LOG_LEVEL=INFO
AGENT_LOG_TYPED_TEXT=false

# --- Android automation layer ------------------------------------------------
# Path to the existing automation project (default: ../../tools/android-ui-automation)
# ANDROID_AUTOMATION_PATH=
ADB_PATH=adb
# Device serial from `adb devices`; leave empty if only one device is connected
ANDROID_DEVICE_ID=
COMMAND_TIMEOUT_SECONDS=30
UI_WAIT_TIMEOUT_SECONDS=5
