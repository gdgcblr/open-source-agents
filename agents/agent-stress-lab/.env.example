# agent-stress-lab configuration
# Copy to .env (cp .env.example .env). Local defaults need no API keys.
# NEVER commit your real .env file.

# --- Models (LiteLLM model ids) ---
# Simulated user. Local Gemma via Ollama by default.
SIM_MODEL=ollama_chat/gemma4:e4b
# Demo agent under test. Must support tool calling (check with: python -m stress_lab check).
TARGET_MODEL=ollama_chat/gemma4:e4b
OLLAMA_API_BASE=http://localhost:11434

# --- Optional hosted model instead of a local one ---
# GEMINI_API_KEY=your_gemini_api_key_here
# TARGET_MODEL=gemini-2.5-flash

# --- Optional cost reporting (USD per 1K tokens of the agent under test) ---
# PRICE_PER_1K_TOKENS=0.0003

# --- Fixed "today" for the mock shop's 30-day return window ---
STRESS_TODAY=2026-10-24
