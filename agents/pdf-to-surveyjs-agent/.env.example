# Get an API key from Google AI Studio. Never commit a real key.
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Gemma model available through the Gemini API. Override if your account uses
# a different supported Gemma model identifier.
PDF_SURVEY_MODEL=gemma-4-26b-a4b-it

# Maximum repair attempts after the initial model response (0-2).
PDF_SURVEY_MAX_RETRIES=1

# Directory the ADK-exposed extraction tool is permitted to read. The default
# is the process working directory. This does not limit a path passed directly
# to main.py by the user.
# PDF_SURVEY_ALLOWED_ROOT=/absolute/path/to/approved/pdfs
