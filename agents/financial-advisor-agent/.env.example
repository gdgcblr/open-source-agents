# =============================================================================
# Autonomous Portfolio & Rebalancing Advisor - Environment Variables
# =============================================================================
# Copy this file to .env before running:
#   cp .env.example .env

# Google Gemini API Key (Required for live AI agent reasoning and recommendations)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (Recommended: gemini-2.5-flash)
MODEL_NAME=gemini-2.5-flash

# Offline / Mock Data Mode
# Set to 1 to force offline/mock market data (useful for testing or offline environments)
USE_MOCK_DATA=0
