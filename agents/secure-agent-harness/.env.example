# Copy to .env and set your own key. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Agent limits
MAX_STEPS=6
MAX_TOOL_CALLS=4
MAX_INPUT_CHARS=8000
MAX_OUTPUT_TOKENS=700
MAX_ESTIMATED_COST_USD=0.03

# Update these to the current provider/model pricing. USD per 1 million tokens.
INPUT_USD_PER_MILLION_TOKENS=0.40
OUTPUT_USD_PER_MILLION_TOKENS=1.60

# Local data; use a unique namespace per authenticated user in services.
MEMORY_DB_PATH=.data/memory.sqlite3
AGENT_USER_ID=local-user
AUDIT_LOG_PATH=.data/audit.jsonl
