# Copy to .env and fill in. Get a free key at https://aistudio.google.com/apikey
# Only needed for `optimize` narration and `chat`; `expiry` works without it.
# NEVER commit your actual '.env' file or any real secret to Git.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional override (default: gemini-3.5-flash)
# MODEL_NAME=gemini-3.5-flash
