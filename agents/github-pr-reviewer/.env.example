# ==============================================================================
# Environment Configuration for GitHub PR Reviewer & Triage Agent
# Copy this file to .env before running: cp .env.example .env
# Never commit real secrets or API keys to version control.
# ==============================================================================

# Google Gemini API Key (Required for LLM-powered reasoning; optional if using --offline mode)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (Optional: only needed for private repos or high API rate limits)
GITHUB_TOKEN=your_github_personal_access_token_here

# LLM Model Configuration
GEMINI_MODEL=gemini-1.5-flash
TEMPERATURE=0.2

# Logging Verbosity: debug, info, warn, error
LOG_LEVEL=info
