# Copy to '.env' only if you want to override defaults. Never commit '.env'.
# No API key is required: the docs review runs on a local Gemma model through Ollama.

# Ollama model used for the README review (any model available to Ollama)
MODEL_NAME=gemma3:4b

# Built-in rules profile: generic or gdgcblr. Leave empty to use .preflight.json in the project, else generic.
PREFLIGHT_PROFILE=

# Set to 1 to look up known vulnerabilities on OSV.dev. Off by default: this is the only
# feature that uses the network, and it sends dependency names and versions (not your code).
PREFLIGHT_VULN_SCAN=

# Name used in report filenames. Leave empty to use the README title.
PROJECT_NAME=

# Host folder for saved PDF/CSV reports (relative to docker-compose.yml)
REPORTS_DIR=./reports

# Absolute or relative path of the project folder to review (mounted read-only)
TARGET_PROJECT=.
