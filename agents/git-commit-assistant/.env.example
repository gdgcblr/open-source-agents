# Environment Variable Configuration Template — git-commit-assistant
# -----------------------------------------------------------------------------
# Copy to '.env' and fill in values only if you want the optional 'openai'
# provider. The default 'mock' provider is fully offline and needs NO config.
# NEVER commit your real '.env' or any secrets.
# -----------------------------------------------------------------------------

# Optional: OpenAI API key. Set this to enable the 'openai' provider.
# When present (and the openai package is installed), --provider auto uses it.
# OPENAI_API_KEY=your_openai_api_key_here

# Optional / future: Gemini API key (provider not yet implemented).
# GEMINI_API_KEY=your_gemini_api_key_here

# Default provider when --provider is omitted. One of: auto | mock | openai.
PROVIDER=auto

# Optional: model name for the openai provider (ignored by mock).
# MODEL_NAME=gpt-4o-mini
