# Copy to .env (cp .env.example .env). Never commit .env.
# No API keys are needed: everything runs against a local Ollama server.

# Ollama server used for triage and by the ADK agent (default shown)
OLLAMA_HOST=http://localhost:11434

# Gemma model used for LLM triage (must be pulled first: ollama pull gemma4:e2b-it-q4_K_M)
OLLAMA_MODEL=gemma4:e2b-it-q4_K_M

# Optional: per-request timeout in seconds for triage calls
# OLLAMA_TIMEOUT=180

# ADK agent only. LiteLLM reads OLLAMA_API_BASE (defaults to OLLAMA_HOST if unset).
OLLAMA_API_BASE=http://localhost:11434

# ADK agent only, optional: chat model for the agent if it differs from the triage model.
# The chat model must support tool calling in Ollama (the gemma3 builds do not, see README).
# OLLAMA_AGENT_MODEL=

# Directory the ADK agent is allowed to scan (default: current working directory).
# Optional: restrict the ADK agent to one folder (default: any local path)
# SECRET_SCANNER_ROOT=
