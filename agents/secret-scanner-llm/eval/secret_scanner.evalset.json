{
  "eval_set_id": "secret_scanner_smoke",
  "name": "secret_scanner_smoke",
  "description": "Tool-trajectory checks (no LLM judge). Cases depend on the chat model choosing to call the tool: results are model-dependent. Run from the project root: adk eval secret_scanner_agent eval/secret_scanner.evalset.json --config_file_path eval/test_config.json --print_detailed_results",
  "eval_cases": [
    {
      "eval_id": "scan_sample_project",
      "conversation": [
        {
          "invocation_id": "inv-scan-1",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "Scan the folder eval/sample_project for hard-coded secrets."
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "I scanned eval/sample_project and summarised the findings using redacted values only."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "scan_path",
                "args": {
                  "path": "eval/sample_project",
                  "use_llm": true
                }
              }
            ],
            "intermediate_responses": []
          }
        }
      ],
      "session_input": {
        "app_name": "secret_scanner_agent",
        "user_id": "eval_user",
        "state": {}
      }
    },
    {
      "eval_id": "remediation_for_aws_key",
      "conversation": [
        {
          "invocation_id": "inv-rem-1",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "I leaked an aws_access_key finding. How do I fix it?"
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Rotate the key first, then move it to an environment variable."
              }
