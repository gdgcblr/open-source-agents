# Environment Variable Configuration – Planning Puppet
# -------------------------------------------------------
# Instructions:
#   1. Copy this file: cp .env.example .env
#   2. Replace placeholder values with your real credentials.
#   3. NEVER commit your actual .env file to Git.
# -------------------------------------------------------

# ── Required ────────────────────────────────────────────
# Google AI Studio API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API key (https://console.cloud.google.com/google/maps-apis)
# Required for live venue search via search_event_venues tool
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Optional: Model Configuration ───────────────────────
# Primary model used by the Planning Puppet agent.
# Default: gemini-2.5-flash
MODEL_NAME=gemini-2.5-flash

# Model used by the LLM-as-a-Judge evaluator.
# Falls back to MODEL_NAME if not set.
EVALUATOR_MODEL=gemini-2.5-flash

# ── Optional: Feature Flags ──────────────────────────────
# Set to 'false' to disable the quality evaluator on startup.
ENABLE_EVALUATOR=true

# ── Optional: Logging ───────────────────────────────────
LOG_LEVEL=info
