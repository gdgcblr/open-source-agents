# ==============================================================================
# Scholar-Agent Environment Variables Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Add your actual API key(s) below.
# 3. Never commit your real .env file to version control.
# ==============================================================================

# Google Gemini API Key (Required for Google ADK Agent)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-key"

# ------------------------------------------------------------------------------
# Runtime Settings
# ------------------------------------------------------------------------------

# Suppress Hugging Face tokenizers parallelism warnings in forked environments
TOKENIZERS_PARALLELISM=false