# Environment Variable Configuration for Issue Onboarder Agent
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' in this directory: cp .env.example .env
# 2. Add your Gemini API key below.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model
MODEL_NAME=gemini-3.8-flash
