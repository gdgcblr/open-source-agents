# Copy this file to `.env` in this directory and fill it in locally.
# Never commit `.env`. Existing process environment variables win.

# Required for --send-to-model. Offline `--check` works without it.
GOOGLE_API_KEY=

# Required for --send-to-model. Choose a Gemini model that supports function calling
# and is available to your key. No model is preselected because availability changes.
PR_DRAFT_MODEL=

# This MVP uses the Gemini Developer API only. Leave Vertex AI disabled.
# GOOGLE_GENAI_USE_VERTEXAI=false
