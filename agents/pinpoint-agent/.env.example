# Pinpoint Agent — environment variables
# -----------------------------------------------------------------------------
# Copy to .env (cp .env.example .env). Mock mode needs no key.
# Never commit a real .env file.
# -----------------------------------------------------------------------------

# Google AI Studio key. Optional: without it the agent uses the offline mock model.
# Read from env only. Never logged. Never passed to the MCP server process.
# GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model id. Re-check https://ai.google.dev/models before use.
# MODEL_NAME=gemini-2.5-flash

# Path to the MCP server entry. Default: ../../tools/pinpoint-mcp-server/src/index.js
# PINPOINT_SERVER_PATH=

# Passed through to the server process. Default: server default.
# PINPOINT_DATA_DIR=

# Maximum tool calls per human turn
# AGENT_MAX_TOOL_CALLS=6

# stderr log level: debug | info | warn | error
# AGENT_LOG_LEVEL=info
