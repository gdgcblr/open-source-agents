# Invoice Chaser — environment configuration
# -----------------------------------------------------------------------------
# 1. Copy this file to '.env':  cp .env.example .env
# 2. Replace placeholder values. NEVER commit your real '.env'.
# 3. The test suite (pytest) uses a scripted mock model and does not need a key.
# -----------------------------------------------------------------------------

# --- Gemini via Google AI Studio (https://aistudio.google.com/apikey) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
# MODEL_NAME=gemini-3.5-flash
# JUDGE_MODEL=gemini-3.5-flash          # used only by evals

# --- Ledger ---
# INVOICE_CHASER_DB=data/ledger.db       # relative paths resolve against this folder
# The bundled sample data is written for this date; remove the line to use the real date.
INVOICE_CHASER_TODAY=2026-10-24
# INVOICE_CHASER_TDS_RATES=0.10          # comma-separated, e.g. 0.10,0.02
# INVOICE_CHASER_SENDER_NAME=Priya
# INVOICE_CHASER_PAYMENT_DETAILS=the bank details on the invoice
