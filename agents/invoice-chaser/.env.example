# Invoice Chaser — environment configuration
# -----------------------------------------------------------------------------
# 1. Copy this file to '.env':  cp .env.example .env
# 2. Replace placeholder values. NEVER commit your real '.env'.
# 3. The test suite (pytest) uses a mock model and does not need a key.
# -----------------------------------------------------------------------------

# --- Gemini via Google AI Studio (https://aistudio.google.com/apikey) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
# MODEL_NAME=

# --- Local storage ---
# INVOICE_CHASER_DB=./data/ledger.db

# --- Logging ---
# LOG_LEVEL=info
