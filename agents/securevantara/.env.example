# Export these values in your shell if using the respective provider.
# Securevantara uses standard environment variables and does not track private credentials.

# Gemini API configuration (optional, for --provider gemini):
GEMINI_API_KEY=your-gemini-api-key-here

# Optional Xalgorix settings:
XALGORIX_LLM_PROVIDER=ollama
XALGORIX_LLM=gemma4:e4b
XALGORIX_API_BASE=http://127.0.0.1:11434
XALGORIX_MAX_ITERATIONS=8
# Local Ollama needs no API key. Do not mount existing credential files.
