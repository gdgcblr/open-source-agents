# Copy to .env. No cloud API key is needed.
MIGINE_TIMEZONE=Asia/Kolkata
MIGINE_DATA_DIR=./data
OLLAMA_API_BASE=http://127.0.0.1:11434
MIGINE_CHAT_MODEL=gemma4:e4b
MIGINE_EMBEDDING_MODEL=embeddinggemma
# Native helper path is set automatically by scripts/setup-local.sh:
# MIGINE_MAC_HELPER=/absolute/project/path/build/MigineConnector.app/Contents/MacOS/MigineConnector
# Docker or remote connector mode. Keep these unset for native mode.
# MIGINE_MAC_CONNECTOR_URL=http://127.0.0.1:8765
# MIGINE_MAC_CONNECTOR_TOKEN_FILE=/absolute/path/to/connector.token
