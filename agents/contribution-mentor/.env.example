# Google Gemini API (OpenAI-compatible endpoint).
# Create a key in Google AI Studio and put it only in your local, git-ignored .env.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=

# Optional GitHub configuration.
GITHUB_TOKEN=
GITHUB_REPO=
EXPERIENCE=
ISSUE=0
IMPLEMENT=false

# Repository and prompt configuration.
PROJECT_DIR=../..
QUESTION=What is a useful first contribution for this repository?

# Used only when LLM_PROVIDER=ollama.
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_SERVER_HOST=ollama:11434
