# Copy this file to .env and fill in your own values. Never commit .env.
# FirstRun reads it at startup. It is NOT passed into the projects it checks.
# Set one provider key. Leave the placeholders as they are to run with the offline rules.

# Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Or a Groq key from https://console.groq.com/keys (open models, very fast)
# GROQ_API_KEY=your_groq_api_key_here

# Optional: force a provider when both keys are set (gemini or groq)
# FIRSTRUN_PROVIDER=groq

# Optional: model id for the chosen provider
# (defaults: gemini-flash-latest for Gemini, openai/gpt-oss-120b for Groq)
# FIRSTRUN_MODEL=gemini-flash-latest
