# ==============================================================================
# Environment Variable Configuration Template — RepoLens
# ------------------------------------------------------------------------------
# SECURITY POLICY:
# 1. Copy this template to '.env': cp .env.example .env
# 2. Populate sensitive values (API keys, database passwords) ONLY in your local '.env'.
# 3. NEVER commit your '.env' file or any credentials to Git repository history.
# ==============================================================================

# --- Gemini / Google AI Studio API Key ---
# Required for AI-powered audit summaries. When unset, scanner-only mode functions cleanly.
GOOGLE_API_KEY=

# --- Gemini Model Identifier ---
GEMINI_MODEL=gemini-2.0-flash

# --- PostgreSQL Database Credentials (Docker & Local) ---
# For Docker Compose:
POSTGRES_USER=repolens
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=repolens

# Full connection URL for backend services:
DATABASE_URL=postgresql://repolens:your_secure_db_password_here@localhost:5432/repolens

# --- Application Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- Scanner Resource Limits & Safety ---
MAX_REPO_SIZE_MB=100
SCAN_TIMEOUT_SECONDS=300
MAX_SNIPPET_BYTES=2048
