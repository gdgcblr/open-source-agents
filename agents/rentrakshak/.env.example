# --- Cloud (Gemini) ---
# Required for ADK chat with Gemini (optional for pytest & deterministic CLI)
GOOGLE_API_KEY=your_gemini_api_key_here
RENTRAKSHAK_MODEL=gemini-2.0-flash

# --- Local Gemma via Ollama (your machine: gemma3:1b / gemma3:4b) ---
# pip install -r requirements-ollama.txt
# RENTRAKSHAK_LLM_BACKEND=ollama
# RENTRAKSHAK_OLLAMA_MODEL=gemma3:4b
# OLLAMA_API_BASE=http://127.0.0.1:11434
# Or auto: use Ollama when no GOOGLE_API_KEY:
# RENTRAKSHAK_USE_OLLAMA=true

# Web UI screenshot OCR (Analyze → upload JPG/PNG)
# RENTRAKSHAK_VISION_BACKEND=auto   # ollama if running, else gemini if key set
# RENTRAKSHAK_VISION_BACKEND=ollama
# RENTRAKSHAK_VISION_MODEL=gemini-2.0-flash

# Optional: Gemma on Vertex AI (not required for local MVP)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1
# RENTRAKSHAK_GEMMA_MODEL=gemma-3-4b-it

# SQLite database path (created automatically)
RENTRAKSHAK_DB_PATH=./data/rentrakshak.db

# Optional Google Cloud Model Armor (paid GCP; leave unset for local-only guardrails)
# MODEL_ARMOR_PROJECT_ID=
# MODEL_ARMOR_LOCATION=us-central1
# MODEL_ARMOR_TEMPLATE_ID=
