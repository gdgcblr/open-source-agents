# =============================================================================
# GitHub PR Guardian - Environment Variables Configuration
# =============================================================================
# Copy this file to '.env' before running:
#   cp .env.example .env
# Never commit your real '.env' file or any actual API tokens to Git.
# =============================================================================

# Google Gemini API Key (Required for LLM code review reasoning)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# GitHub Personal Access Token (Optional: increases rate limits for fetching PRs)
# Public PR diffs can also be fetched without a token.
GITHUB_TOKEN=your_optional_github_token_here
