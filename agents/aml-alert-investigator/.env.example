# Environment variables for aml-alert-investigator
# 1. Copy this file: cp .env.example .env
# 2. Fill in your own values.
# 3. NEVER commit your real .env file.

# Gemini API key from https://aistudio.google.com/app/apikey
# Not needed for `npm run detect` or `npm run investigate -- --no-llm`.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: comma-separated Gemini models, tried in order.
# MODEL_NAME=gemini-flash-lite-latest,gemini-flash-latest

# Optional: per-model time limit in milliseconds before falling back to the next model.
# GEMINI_TIMEOUT_MS=45000

# Optional (used by `npm run chat` / `npm run web`): data folder and rule overrides.
# AML_DATA_DIR=data
# AML_RULES_FILE=rules.json
