
# SQLBuddy environment configuration
# Copy this file to .env and add your private API key.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Optional Python logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=WARNING

# Full-stack web app settings (used by backend/app)
SQLBUDDY_DATABASE_PATH=./data/sqlbuddy.db
SQLBUDDY_FRONTEND_ORIGIN=http://localhost:5173
SQLBUDDY_RATE_LIMIT_REQUESTS=20
SQLBUDDY_RATE_LIMIT_WINDOW_SECONDS=60
SQLBUDDY_REQUEST_TIMEOUT_SECONDS=120
SQLBUDDY_MAX_QUESTION_CHARS=4000
SQLBUDDY_MAX_SCHEMA_CHARS=12000
