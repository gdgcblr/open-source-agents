# Environment Variable Configuration for NanoNavs Road Intelligence
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Replace the placeholder values below with your own valid credentials.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# --- Google Gemini API (OPTIONAL) ---
# The agent works fully without this key using deterministic local analysis.
# When provided, Gemini enhances incident reports with natural-language narratives.
# GEMINI_API_KEY=your_gemini_api_key_here

# --- Model Settings ---
# MODEL_NAME=gemini-2.5-flash
# TEMPERATURE=0.2

# --- Application Configuration ---
# NANONAVS_LOG_LEVEL=info
# NANONAVS_REPORT_DIR=reports
