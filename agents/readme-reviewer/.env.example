# Copy to '.env' (cp .env.example .env) and fill in your own key.
# NEVER commit the real '.env' file.

# --- Model provider: gemini (default) or nvidia ---
MODEL_PROVIDER=gemini

# Gemini: key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
# Model id. Default for gemini is gemini-2.5-flash.
# For nvidia, set the exact model id from https://build.nvidia.com (required).
MODEL_NAME=gemini-2.5-flash

# NVIDIA (only when MODEL_PROVIDER=nvidia)
# NVIDIA_API_KEY=your_nvidia_api_key_here
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Guardrails (optional) ---
# Folder the tools may access. Default: the enclosing git repository.
# ALLOWED_ROOT=/path/to/open-source-agents
# Max tool calls per agent per run (default 12).
# MAX_TOOL_CALLS=12
# Branch the scope check compares against (default: upstream/main, origin/main, main).
# BASE_REF=upstream/main
# Set to off to skip the git-based PR scope check (the evals do this so results do not depend on repo state).
# PR_SCOPE=on
