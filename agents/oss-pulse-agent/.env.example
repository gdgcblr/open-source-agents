# OSS Pulse Agent - Environment Configuration
# Copy this file to .env and fill in your values

# Required: Google Gemini API Key
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: GitHub Personal Access Token
# Increases rate limits from 60 to 5000 requests/hour
# Create at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your_github_token_here_optional
