# Environment Variable Configuration Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' in your project directory: cp .env.example .env
# 2. Replace placeholder values below with your valid credentials.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# Google AI Studio / Gemini API Key (Required for full LLM reasoning)
GOOGLE_API_KEY=your_gemini_api_key_here

# Default model used by Google ADK (Options: gemini-3.8-flash, gemini-2.5-flash)
ADK_MODEL=gemini-3.8-flash

# Instructor Administration Secret Key (For accessing the /api/admin/* portal)
ADMIN_SECRET_KEY=gdg-hackathon-secure-admin-key-2026

# Production Debug Flag (Strictly False in production)
APP_DEBUG=false

# SQLite Database File Location
DATABASE_PATH=troubleshooter.db
