# Demo storage is local-only. Firebase/Neon are not connected in this milestone.
TRAVELOGUE_MODE=demo
# demo = clearly labeled scripted output; ollama = actual local Gemma through ADK
MODEL_PROVIDER=demo
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# Smaller context and stage-specific generation budgets reduce work per request.
OLLAMA_CONTEXT_TOKENS=8192
OLLAMA_RESEARCH_TOKENS=384
OLLAMA_REVIEW_TOKENS=512
OLLAMA_MAX_PLAN_TOKENS=4096
# Keep model weights resident for repeated planning requests.
OLLAMA_KEEP_ALIVE=15m
PLANNER_TIMEOUT_SECONDS=120
# Optional live research. Without it, agents receive curated evidence only.
TAVILY_API_KEY=
# Reserved for the next integration milestone; do not enable public deployment yet.
DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
