# PR Sentinel - Environment Variable Configuration
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Add your Google Gemini API key if you wish to run live LLM reasoning.
# 3. If no key is provided, PR Sentinel automatically runs in high-fidelity
#    deterministic simulation mode (--demo) without requiring any paid API.
# 4. NEVER commit your actual '.env' file or private keys to Git.
# -----------------------------------------------------------------------------

# Primary LLM Provider: Google Gemini
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (Supported: gemini-3.8-flash, gemini-2.5-pro, etc.)
GEMINI_MODEL=gemini-3.8-flash

# Force Mock / Simulation Mode (true/false)
MOCK_MODE=false

# Embedded Web Dashboard Server Settings
PORT=3737
HOST=localhost

# Limits & Logging
LOG_LEVEL=info
MAX_DIFF_LINES=5000
