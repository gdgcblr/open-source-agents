# Copy to .env. Everything is optional: the default offline mode needs no keys.
# Never commit .env or real credentials.

# Model-assisted mode (--allow-upload): gemini | ollama (local Gemma etc.)
AI_PROVIDER=gemini
# Defaults: gemini-3.8-flash for gemini, gemma3 for ollama
AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your_gemini_api_key_here
# OLLAMA_HOST=http://localhost:11434

# Raises GitHub API rate limits when fetching issues
# GITHUB_TOKEN=your_github_token_here

# A2A server
# A2A_PORT=4747
# A2A_ALLOW_UPLOAD=1
