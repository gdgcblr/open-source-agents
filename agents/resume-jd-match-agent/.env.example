# Copy this file to resume_jd_agent/.env and add your Gemini API key.
# Get a free key at https://aistudio.google.com/apikey
# NEVER commit the real .env file.

# Use the Gemini API (Google AI Studio), not Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-key-here

# Optional
# RESUME_JD_CACHE=off   # always regenerate reports instead of reusing cached ones
# RESUME_JD_OCR=off     # never send scanned PDFs to Gemini for OCR
