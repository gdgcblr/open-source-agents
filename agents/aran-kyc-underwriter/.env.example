# Aran KYC Underwriter - environment configuration
# -----------------------------------------------------------------------------
# 1. Copy this file to '.env' in this directory: cp .env.example .env
# 2. Replace the placeholder values below.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# --- Cloud model (reasoning only; it never receives raw personal data) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.6-flash

# --- Case documents (read locally by Aran) ---
# Defaults to the synthetic sample case in tools/aran-llm-privacy-gateway/samples/kyc
# CASE_DIR=/absolute/path/to/applicant/documents

# --- Local privacy model (runs on this machine via Ollama) ---
# ARAN_LOCAL_MODEL=gemma4:12b
# OLLAMA_HOST=http://localhost:11434
# ARAN_HOME=~/.aran
