# Copy to .env for optional Gemini mode. Never commit .env.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=YOUR_API_KEY_HERE
MODEL_NAME=gemini-3.5-flash-lite
TRIAGE_AI_TIMEOUT_SECONDS=60
TRIAGE_ADVISORY_MAX_AGE_DAYS=7
# Optional paths; defaults are relative to this project, not the terminal directory.
# TRIAGE_LOG_DIR=C:/path/to/approved/logs
# TRIAGE_ADVISORY_PATH=C:/path/to/reviewed/advisories.json
# TRIAGE_EVAL_REPORT=C:/path/to/evaluation-report.json
