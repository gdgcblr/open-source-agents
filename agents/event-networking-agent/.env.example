# Environment Variable Configuration
# -----------------------------------------------------------------------------
# 1. Copy this file to '.env' in this directory: cp .env.example .env
# 2. Replace the placeholder values below.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# --- Model ---
# Gemini API key from https://aistudio.google.com/apikey. Leave unset to run fully offline.
# GEMINI_API_KEY=your_gemini_api_key_here
# auto = use Gemini when a key is set | offline = never call the LLM | gemini = require a key
LLM_MODE=auto
MODEL_NAME=gemini-3.1-flash-lite

# --- Event ---
EVENT_CONFIG=config/event.example.yaml
# Organiser secret for starting rounds. If unset, a random one is generated and logged at startup.
# ADMIN_TOKEN=change_me_to_a_long_random_string
# Comma-separated origins allowed to call the API (your hosted UI). "*" allows any.
CORS_ORIGINS=*
