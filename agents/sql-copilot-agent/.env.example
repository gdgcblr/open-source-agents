# Environment Variable Configuration — SQL Copilot Agent
# -----------------------------------------------------------------------------
# 1. Copy this file to '.env':   cp .env.example .env
# 2. Fill in your Gemini API key (free: https://aistudio.google.com/apikey)
# 3. NEVER commit your real '.env'.
# -----------------------------------------------------------------------------

# Required: Gemini / Google AI Studio API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default model.
# MODEL_NAME=gemini-3.8-flash

# Optional: point the agent at your own database (defaults to the bundled
# SQLite demo). Any SQLAlchemy connection string works:
# DATABASE_URL=sqlite:///path/to/your.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname
