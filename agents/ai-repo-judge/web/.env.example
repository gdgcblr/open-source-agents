# Dashboard data source. Default: static JSON produced by `judge run` (copied into public/data).
# Set to firestore to read the documents written by `judge run --store firestore` instead.
VITE_DATA_SOURCE=static

# Firebase web config (only for VITE_DATA_SOURCE=firestore). The web API key identifies the project and is
# not a secret, but restrict it in the Firebase console and allow public reads only on meta/index and details.
# VITE_FIREBASE_API_KEY=your_firebase_web_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
