{
  "name": "merge-mentor",
  "version": "0.1.0",
  "description": "Finds open-source issues in your language and level that you can actually get merged, then an AI agent explains the code and how to fix them.",
  "type": "module",
  "bin": {
    "merge-mentor": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "demo": "node dist/cli.js --demo --lang typescript --level beginner --pick 1",
    "record-demo": "node dist/record-demo.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "ui": "node dist/server.js",
    "ui:demo": "node dist/server.js --demo",
    "record-demo:mentor": "node dist/record-demo.js --mentor-only"
  },
  "engines": {
    "node": ">=20.12"
  },
  "license": "MIT",
  "dependencies": {
    "@google/genai": "2.31.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
