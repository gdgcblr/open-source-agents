# merge-mentor environment configuration
# -----------------------------------------------------------------------------
# 1. Copy this file to '.env' in this folder:  cp .env.example .env
# 2. Replace the placeholder values with your own keys.
# 3. NEVER commit your real '.env' file. It is already listed in .gitignore.
# -----------------------------------------------------------------------------

# Gemini API key from https://aistudio.google.com/apikey
# Optional: without it, merge-mentor still finds and scores issues (no AI explanation).
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred Gemini model. If it hits the free-tier quota, merge-mentor falls back to
# gemini-3.5-flash-lite and gemini-3.1-flash-lite automatically.
MODEL_NAME=gemini-3.6-flash

# GitHub fine-grained token: "Public repositories (read-only)", no other permissions.
# Optional but recommended: raises GitHub API limits from 60 to 5,000 requests/hour
# and enables the agent's code-search tool.
# Create one at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=your_github_token_here
