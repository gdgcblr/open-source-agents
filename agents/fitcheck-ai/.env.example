# Environment Variable Configuration — FitCheck AI
# -----------------------------------------------------------------------------
# 1. Copy this file to '.env':  cp .env.example .env
# 2. NEVER commit your actual '.env' file.
# -----------------------------------------------------------------------------

# --- Option A (default): hosted Gemma via the Gemini API -------------------
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Which Gemma to use (defaults to gemma-4-26b-a4b-it when a key is set).
# Run `python scripts/check_api.py` to list the Gemma models your key can use.
# FITCHECK_MODEL=gemma-4-26b-a4b-it      # fast MoE — recommended
# FITCHECK_MODEL=gemma-4-31b-it          # strongest, slower
# FITCHECK_MODEL=gemma-3-27b-it          # Gemma 3 (ADK applies prompt workarounds)

# Optional: a different model just for reading outfit photos
# FITCHECK_VISION_MODEL=gemma-4-31b-it

# Gemma 4 thinking level. Default "minimal" = fast, and avoids empty answers
# when thinking uses up the token budget. "high" = deeper, slower.
# "default" = leave it to the model.
# FITCHECK_THINKING=minimal

# Optional tuning
# FITCHECK_RETRY_ATTEMPTS=5      # retries on 429 / 5xx with exponential backoff
# FITCHECK_MAX_TOKENS=4096

# --- Option B: local Gemma via Ollama (no key, photos never leave your machine)
# Remove GOOGLE_API_KEY above, then:
# FITCHECK_MODEL=ollama_chat/gemma3:4b
# OLLAMA_API_BASE=http://localhost:11434

# --- Server ---
# HOST=127.0.0.1
# PORT=8000
