# Environment Variable Configuration — FitCheck AI
# -----------------------------------------------------------------------------
# 1. Copy this file to '.env':  cp .env.example .env
# 2. NEVER commit your actual '.env' file.
# -----------------------------------------------------------------------------

# --- Model (any LiteLLM model string) ---
# Default: Gemma 3 4B running locally via Ollama (vision-capable, no API key needed)
FITCHECK_MODEL=ollama_chat/gemma3:4b

# Optional: use a different model just for reading outfit photos (must support images)
# FITCHECK_VISION_MODEL=ollama_chat/gemma3:12b

# Ollama endpoint (only if not on the default http://localhost:11434)
# OLLAMA_API_BASE=http://localhost:11434

# Optional: hosted Gemma via Google AI Studio instead of Ollama (untested)
# FITCHECK_MODEL=gemini/gemma-3-27b-it
# GEMINI_API_KEY=your_gemini_api_key_here

# --- Server ---
# HOST=127.0.0.1
# PORT=8000
