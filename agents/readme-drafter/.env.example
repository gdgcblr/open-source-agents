# README Drafter configuration
# -----------------------------------------------------------------------------
# Copy to '.env' in this folder: cp .env.example .env
# Docker Compose and `adk web` both read it. No API keys are needed.
# NEVER commit your actual '.env' file.
# -----------------------------------------------------------------------------

# Folder of the project you want a README for (absolute path on your machine).
# Required for Docker. Local runs default to the current folder.
# PROJECT_DIR=/path/to/your/project

# Optional: project name to use in the README. Defaults to the folder name.
# PROJECT_NAME=my-project

# Ollama model tag. Must support tool calling (gemma4 does, gemma3 does not).
MODEL_NAME=gemma4:e4b

# Context window passed to Ollama, in tokens.
NUM_CTX=32768

# Where the agent reaches Ollama. Leave unset to use the defaults:
# local run -> http://localhost:11434, Docker -> the bundled ollama service.
# Docker on macOS using Ollama installed on the Mac (fast, uses the GPU):
# OLLAMA_API_BASE=http://host.docker.internal:11434
