# Copy this file to .env (`make env`) and fill in the values.
# Never commit .env: it holds your API keys. It is listed in .gitignore.
# Every variable is described in the README's "Configuration & Environment Variables" table.

# --- Required -------------------------------------------------------------------
# Deepgram API key (https://console.deepgram.com). Powers the voice agent and diarization.
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# Dashboard login (HTTP Basic auth). The backend refuses to start with this example password.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-to-a-long-random-password

# --- Twilio (needed to answer phone calls; uploads work without it) ---------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Public HTTPS URL that reaches the backend, e.g. from `make tunnel`. No trailing slash.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
# Record calls so they can be diarized afterwards. Make sure callers are told (see README).
RECORD_CALLS=true
TWILIO_VALIDATE_SIGNATURE=true

# --- Hospital ------------------------------------------------------------------------
# Folder with hospital.md (information) and doctors.csv (roster), relative to backend/. It seeds
# the database on first start only; after that, edit the hospital on the dashboard's Hospital
# page. knowledge/medcare-sample is a fully fictional alternative.
HOSPITAL_DIR=knowledge/sahyadri-deccan
# IANA timezone, so the agent knows the hospital's local date and time for bookings.
HOSPITAL_TIMEZONE=Asia/Kolkata
# Appointments must start within this many hours. If the caller needs a later time, or the
# doctor has nothing free in that window, the receptionist apologises and ends the call.
BOOKING_WINDOW_HOURS=72

# --- Voice agent ---------------------------------------------------------------------
# LLM run by Deepgram on your behalf, billed to your Deepgram account (no extra key).
AGENT_LLM_PROVIDER=anthropic
AGENT_LLM_MODEL=claude-sonnet-5
# Leave empty for the built-in receptionist instructions and greeting. AGENT_PROMPT replaces the
# instructions only; the safety rules, hospital information and local time are always added.
# Keep the recording notice if you set your own greeting.
AGENT_PROMPT=
AGENT_GREETING=

# --- Guardrails ----------------------------------------------------------------------
# The receptionist says goodbye and hangs up at this length, so an open line can't run up costs.
MAX_CALL_MINUTES=15
# Most appointments a single call can book.
MAX_BOOKINGS_PER_CALL=3
# Answers to "English or Hindi?" that are neither, before the receptionist ends the call.
MAX_LANGUAGE_ATTEMPTS=3

# --- Languages -------------------------------------------------------------------------
# Flux Multilingual understands English, Hindi and callers who mix the two. For an English-only
# line use flux-general-en and leave the hints empty.
DEEPGRAM_LISTEN_MODEL=flux-general-multi
DEEPGRAM_LANGUAGE_HINTS=en,hi
# Each voice speaks one language. The receptionist starts in English and switches to the Hindi
# voice when the caller speaks Hindi or asks for it.
DEEPGRAM_SPEAK_MODEL=flux-priya-en
DEEPGRAM_SPEAK_MODEL_HINDI=flux-anjali-hi
# Recordings are transcribed after the call. "multi" handles mixed Hindi and English; use "en"
# (and TRANSCRIPTION_USD_PER_MINUTE=0.0043) for an English-only line.
DEEPGRAM_DIARIZE_MODEL=nova-3
DEEPGRAM_DIARIZE_LANGUAGE=multi

# --- Cost estimates (USD, Deepgram pay-as-you-go list prices) ---------------------------
# Voice Agent per connected minute: 0.163 for Advanced-tier LLMs (claude-sonnet-5),
# 0.075 for Standard-tier ones (claude-haiku-4-5). Update it if you change AGENT_LLM_MODEL.
VOICE_AGENT_USD_PER_MINUTE=0.163
# Nova-3 pre-recorded transcription per audio minute; diarization is included. 0.0052 for
# multilingual, 0.0043 for a single language.
TRANSCRIPTION_USD_PER_MINUTE=0.0052

# --- Application ---------------------------------------------------------------------
LOG_LEVEL=INFO
MAX_UPLOAD_MB=100
# Relative to backend/ for local development; Docker overrides both to use its volume.
DATABASE_URL=sqlite+aiosqlite:///./data/reception_calls.db
RECORDINGS_DIR=./data/recordings
