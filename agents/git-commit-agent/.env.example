# Environment Variable Configuration
# -----------------------------------------------------------
# 1. Copy this file: cp .env.example .env
# 2. Fill in your real values in .env
# 3. NEVER commit .env to Git
# -----------------------------------------------------------

# Required: Gemini API key from https://aistudio.google.com/app/apikey
# Note: GOOGLE_API_KEY is also automatically recognized if already set in your shell.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the default Gemini model
# Default: gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash
