# Environment Variable Configuration Template
# -----------------------------------------------------------------------------
# 1. Copy this file to '.env' in this folder: cp .env.example .env
# 2. Replace the placeholder values below. NEVER commit your real '.env'.
# Everything is optional: with no key at all, the deterministic checks still run.
# -----------------------------------------------------------------------------

# --- Gemini (AI reviewers, coordinator, README drafter) ---
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here   # alias, either works
# Set to TRUE to use Vertex AI (with GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION) instead of an API key.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Comma-separated fallback chain; tried in order on 429/503, then deterministic-only.
GATEKEEPER_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash

# --- GitHub ---
# Optional. Public PRs work without it (60 API calls/hour); the gh CLI login is used if present.
# Read-only scope is enough for reviews; posting comments (--post) needs pull-request write access.
GITHUB_TOKEN=your_github_token_here

# --- Local cache for bare clones of reviewed repositories ---
# GATEKEEPER_CACHE=~/.cache/mergewarden
