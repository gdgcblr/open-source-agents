# Environment Variable Configuration Template
# -----------------------------------------------------------------------------
# 1. Copy this file to '.env' in this folder: cp .env.example .env
# 2. Replace the placeholder values below. NEVER commit your real '.env'.
# Everything is optional: with no key at all, the deterministic checks still run.
# -----------------------------------------------------------------------------

# --- Gemini (AI reviewers, coordinator, README drafter) ---
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here   # alias, either works
# Set to TRUE to use Vertex AI (with GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION) instead of an API key.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Comma-separated fallback chain; tried in order on 429/503, then deterministic-only.
GATEKEEPER_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash

# --- GitHub ---
# Optional. Public PRs work without it (60 API calls/hour); the gh CLI login is used if present.
# Read-only scope is enough for reviews; posting comments (--post) needs pull-request write access.
GITHUB_TOKEN=your_github_token_here

# --- Local cache for bare clones of reviewed repositories ---
# GATEKEEPER_CACHE=~/.cache/mergewarden

# =============================================================================
# Newcomer Coach (python -m mergewarden.coach serve). The web simulator needs only
# GOOGLE_API_KEY; everything below is optional.
# =============================================================================
# GATEKEEPER_COACH_MODEL=gemini-3.8-flash
# GATEKEEPER_COACH_FALLBACK_MODEL=gemini-3.5-flash-lite
# Comma-separated allowlist of repos the coach recommends issues from and awards PR points for.
# COACH_REPOS=gdgcblr/open-source-agents
# COACH_DATA_DIR=./.coach-data
# "github" = recommend skill-matched issues from all of GitHub; "allowlist" = only COACH_REPOS + event challenges.
# COACH_DISCOVERY=github
# Ignore repos with fewer stars when recommending issues.
# COACH_MIN_STARS=20
# A verified PR to a repo at least this popular (not the student's own) earns the Explorer badge.
# COACH_EXPLORER_MIN_STARS=50
# Long random secret for hashing phone numbers and signing draft links. Never change it after launch.
COACH_SALT=replace_with_a_long_random_string
# COACH_PORT=8090
# LOG_LEVEL=INFO

# --- Coach limits ---
# COACH_RATE_LIMIT_MSGS=20
# COACH_RATE_LIMIT_WINDOW_S=600
# COACH_MAX_AUDIO_BYTES=5242880
# COACH_MAX_AUDIO_SECONDS=120
# COACH_MAX_TEXT_CHARS=2000
# COACH_MAX_TURNS_PER_SESSION=60
# COACH_DAILY_POINT_CAP=100

# --- Coach: MergeWarden review of a student's PR ---
# COACH_REVIEW_USE_LLM=1
# COACH_REVIEW_TIMEOUT_S=600
# COACH_REVIEW_COOLDOWN_S=300
# COACH_MAX_REVIEWS_PER_DAY=5
# COACH_REVIEW_CONCURRENCY=2
# Skip automatic MergeWarden reviews of repos larger than this (clone cost).
# COACH_REVIEW_MAX_REPO_MB=200

# --- WhatsApp via Twilio (only for real WhatsApp; the simulator needs none) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public HTTPS URL Twilio calls (e.g. your ngrok URL). Must match exactly for signature checks.
# PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
