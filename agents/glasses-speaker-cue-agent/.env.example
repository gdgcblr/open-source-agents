# Environment Variable Configuration Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' in your project directory: cp .env.example .env
# 2. Replace the placeholder values below with your own valid credentials.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# --- Model & API Provider (required) ---
# Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Use the Gemini Developer API (AI Studio), not Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- HTTP server (only for server.py) ---
# Shared secret apps must send as the X-Agent-Token header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# AGENT_TOKEN=paste_a_random_value_of_at_least_24_characters

# --- Model Settings (optional) ---
# Any Gemini model that accepts text and images.
# MODEL_NAME=gemini-3.5-flash
