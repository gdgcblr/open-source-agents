# Environment Variable Configuration Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' in your project directory: cp .env.example .env
# 2. Replace the placeholder values below with your own valid credentials.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# --- Optional LLM Provider (Semantic Risk Reasoning Enrichment) ---
# If omitted, BlastRadius operates in 100% deterministic offline heuristic mode.
# LLM enrichment requires BOTH a valid API key AND explicit opt-in.
# GEMINI_API_KEY=your_gemini_api_key_here

# --- LLM Opt-In (required to send diff data to external API) ---
# BLAST_RADIUS_ENABLE_LLM=true

# --- Model Settings (When LLM Mode is Active) ---
# MODEL_NAME=gemini-2.5-flash

# --- Application Logging ---
LOG_LEVEL=info
