# Project V.U.L.C.A.N. Environment Variables
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Add your Gemini API key from Google AI Studio (https://aistudio.google.com/)
# -----------------------------------------------------------------------------

# Google Gemini API Key
GEMINI_API_KEY=your_api_key

# Model Specification (Gemini 3.8 Flash)
MODEL_NAME=gemini-3.8-flash

# Network & Port Configuration
HOST=127.0.0.1
FORENSICS_PORT=8001
FINOPS_PORT=8002

# FinOps Simulation Parameters
TARGET_RPS=150

# Voice Synthesizer Toggle
VOICE_ENABLED=true
