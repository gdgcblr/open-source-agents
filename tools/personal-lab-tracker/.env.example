# Copy to .env if you want to override local defaults:
#   cp .env.example .env
#
# This app stores model choices and an optional OpenAI key in the local
# database from the Settings page. Do not put API keys in this file.
# Never commit .env, the database, or uploaded lab PDFs.

# Signs the session cookie. If unset, the server creates data/session.secret.
# SESSION_SECRET=replace-with-a-long-random-string

# SQLite file. Created on first run. Gitignored.
# LAB_DB_PATH=data/labs.sqlite
