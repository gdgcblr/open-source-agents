# d3v-keyguard configuration (all optional). Nothing loads this file automatically:
# export these in your shell (or set them in your agent's environment). Never commit real values.
# KEYGUARD_VAULT_PATH=/path/to/vault.json   # keep it outside synced folders such as OneDrive
# KEYGUARD_PROMPT=auto            # auto (GUI dialog, terminal only if no GUI) | gui | tty; ADK and CLI
# KEYGUARD_IDLE_TIMEOUT=300       # seconds
# KEYGUARD_MAX_SESSION=3600       # seconds
# KEYGUARD_POLICY_FILE=policy.json   # {"call_api": ["demo_*"], "exec:gh": ["github_token"]}
# KEYGUARD_ALLOW_LLM_VALUES=0     # 1 = store_secret gets a `value` parameter (values pass through the model; not recommended)
# KEYGUARD_STORE_REQUIRES_UNLOCK=0

# Demo agent: adk web reads examples/adk_demo_agent/.env, but that file is plaintext.
# Prefer keeping the key in the vault:
#   d3v-keyguard add google_api_key
#   d3v-keyguard exec --env GOOGLE_API_KEY=keyguard://google_api_key -- adk web
# GOOGLE_API_KEY=your_gemini_api_key_here
# MODEL_NAME=gemini-2.5-flash
