# adk-leak-arena environment configuration
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' in this directory: cp .env.example .env
# 2. Every variable is optional. The defaults below match the bundled
#    docker-compose.yml database (localhost:54330) and work as-is.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
#
# Docker Compose reads '.env' automatically, but only GEMINI_API_KEY is passed
# through to the web container; the DSNs and Ollama settings for the container
# are set in docker-compose.yml. For local `leak-arena` runs, export these
# variables in your shell (the CLI does not load '.env' by itself).
# -----------------------------------------------------------------------------

# --- Database (PostgreSQL 16 + pgvector) ---
# Non-superuser role used for every measured read (NOSUPERUSER NOBYPASSRLS).
ARENA_DB_DSN=postgresql://memshield_app:memshield_pass@localhost:54330/memshield
# Admin role used only for schema setup, reseeding and synthetic scale rows.
ARENA_ADMIN_DSN=postgresql://postgres:postgres_admin_pass@localhost:54330/memshield

# --- Engine: ollama_gemma (optional, local open-weights model) ---
# Model ids use the LiteLLM route prefix, e.g. ollama_chat/gemma3:4b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=ollama_chat/gemma3:4b

# --- Engine: gemini_api (optional, cloud) ---
# Leave unset to keep the default offline deterministic_agent engine.
# GOOGLE_API_KEY is accepted as a fallback name.
# GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- Application ---
# ADK app_name bound into every memory row and RLS context.
ARENA_APP_NAME=acme_enterprise_copilot
# Record one deterministic baseline run at server startup (set 0 to disable).
ARENA_STARTUP_BASELINE=1
