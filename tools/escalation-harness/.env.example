# Copy this file to .env and fill in your key: cp .env.example .env
# NEVER commit .env.

# Gemini API key from https://aistudio.google.com/apikey (free tier works)
GOOGLE_API_KEY=your_gemini_api_key_here

# Model used by the demo agent and the evals
MODEL_NAME=gemini-3.5-flash-lite

# Set to off to try the demo agent in adk web without the harness
HARNESS=on
