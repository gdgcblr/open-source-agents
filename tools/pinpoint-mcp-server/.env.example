# Pinpoint MCP Server — environment variables
# -----------------------------------------------------------------------------
# Copy to .env (cp .env.example .env). Every variable is optional; defaults apply
# when a line is commented out. This server needs NO API keys and makes NO network calls.
# Never commit a real .env file.
# -----------------------------------------------------------------------------

# Directory for store.json, quarantine.json, audit.jsonl, exports/, imports/.
# Default: <server folder>/.data  (must not be a filesystem root)
# PINPOINT_DATA_DIR=

# Log level for stderr output: debug | info | warn | error
# PINPOINT_LOG_LEVEL=info

# Audit log of tool calls (args hash only, never message text): on | off
# PINPOINT_AUDIT=on

# Secret redaction before storage: on | off
# PINPOINT_REDACT=on

# Maximum tool calls per minute for the process
# PINPOINT_RATE_LIMIT_PER_MIN=120
