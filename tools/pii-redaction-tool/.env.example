# Environment Variable Configuration Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' in your project directory: cp .env.example .env
# 2. Replace the placeholder values below with your own valid credentials.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# --- AI Model Configuration ---
# Ollama (local AI) - privacy-preserving, no data leaves your computer
# Install Ollama from https://ollama.com
# Run: ollama pull llama3.2
# Then set ENABLE_AI_DETECTION=true to use local AI
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# --- Detection Configuration ---
# Confidence threshold for PII detection (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.7

# Enable/disable detection layers
ENABLE_REGEX_DETECTION=true
ENABLE_AI_DETECTION=false

# --- Redaction Configuration ---
# Redaction strategy: full, partial, hash, mask
REDACTION_STRATEGY=full

# Character used for full redaction
REDACTION_CHAR=[REDACTED]

# Number of characters to show in partial redaction
PARTIAL_REDACTION_LENGTH=4

# --- Compliance Configuration ---
# Compliance mode: GDPR, CCPA, HIPAA, STRICT
COMPLIANCE_MODE=GDPR

# --- Guardrails Configuration ---
# Maximum input size in bytes (10MB default)
MAX_INPUT_SIZE=10000000

# Rate limiting: requests per period
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Enable audit logging
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_PATH=audit.log

# --- Evaluation Configuration ---
# Enable evaluation mode
ENABLE_EVALUATION=false
EVALUATION_DATA_PATH=test_data/

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
