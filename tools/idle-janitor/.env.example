# idle-janitor configuration (all optional)
# ---------------------------------------------------------------
# idle-janitor has NO required environment variables and makes NO
# network calls. The entries below are reserved for upcoming tunables
# so secrets never need to be scattered across the codebase.
# ---------------------------------------------------------------

# CPU percentage below which a resource is treated as idle.
# IDLE_CPU_THRESHOLD=1.0

# Electricity tariff used for the rupee estimate (INR per kWh).
# INR_PER_KWH=8.0

# Path to a custom watts lookup JSON (overrides the built-in table).
# WATTS_TABLE_PATH=./watts.json
