# ==============================================================================
# Arthaniti Quant Hub Environment Configuration
# Copy this file to .env before starting:
#   cp .env.example .env
# ==============================================================================

# Google Gemini / Gemma API Key (Get a free key at https://aistudio.google.com/app/apikey)
# NOTE: Can also be configured directly in the terminal UI via "🔑 API Key"!
# If left empty, Arthaniti operates in Zero-Key Deterministic Fast-Path Mode ($0.00 cost, offline-ready).
GEMINI_API_KEY=

# Active Recommended Models (Selectable in Web UI):
# - gemini-2.5-flash        (Recommended Default: Fast thesis synthesis)
# - gemini-2.5-pro          (Deep reasoning institutional thesis)
# - gemini-2.5-flash-lite   (Ultra fast inference)
# - gemini-1.5-flash        (LTS general purpose)
# - gemma-2-9b-it           (Google DeepMind Open Weights institutional strategist)
#
# DEPRECATED MODELS (DO NOT USE):
# - gemini-1.0-pro / gemini-pro (DEPRECATED)
# - gemini-pro-vision (SHUT DOWN)
DEFAULT_MODEL=gemini-2.5-flash

# Service Port
PORT=8002
HOST=0.0.0.0
