{
  "name": "browser-qa-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-accessible browser QA agent: executes structured test plans with Playwright, verifies outcomes with explicit assertions, and produces evidence-backed JSON reports.",
  "license": "MIT",
  "keywords": ["mcp", "model-context-protocol", "playwright", "browser-testing", "qa", "e2e-testing", "ai-agent"],
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "browser-qa-mcp": "dist/mcp/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:app": "node fixtures/demo-app/server.js",
    "run:plan": "tsx src/index.ts",
    "report:html": "tsx src/report-to-html.ts",
    "mcp": "tsx src/mcp/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.48.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
