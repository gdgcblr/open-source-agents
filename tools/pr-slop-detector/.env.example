# Environment Variable Configuration
# -----------------------------------------------------------------------------
# 1. Copy this file to '.env':  cp .env.example .env
# 2. Replace the placeholder values below with your own credentials.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# --- LLM backend --------------------------------------------------------------
# "ollama" (default): Google's open-weights Gemma 4, run locally by Ollama. No API key needed.
# "gemini": hosted Gemini via Google AI Studio (set GOOGLE_API_KEY below).
LLM_PROVIDER=ollama

# Model name. Defaults: gemma4:e2b-it-qat for ollama (4.3 GB, fits 8 GB RAM), gemini-3.5-flash for gemini.
# With 16 GB+ RAM, gemma4:e4b or gemma4:12b give noticeably better reviews.
# MODEL_NAME=gemma4:e2b-it-qat

# Ollama server and context window (tokens). Larger windows need more RAM.
# OLLAMA_API_BASE=http://localhost:11434
# OLLAMA_NUM_CTX=16384

# Only for LLM_PROVIDER=gemini
# GOOGLE_API_KEY=your_gemini_api_key_here

# --- GitHub -------------------------------------------------------------------
# Optional for public repos (raises rate limit), required for --post-comment / --label
GITHUB_TOKEN=your_github_token_here

# --- Scoring ------------------------------------------------------------------
# Score (0-100) at or above which a PR is flagged as likely slop
SLOP_THRESHOLD=60
