# Only needed for `prcheck check --ai` and `python -m evals.run_ai_eval`.
# The core checks run fully offline and need no configuration.
#
# 1. Copy this file to `.env` in this folder:  cp .env.example .env
# 2. Replace the placeholder with your own key from https://aistudio.google.com/apikey
# 3. Never commit `.env` (it is already in .gitignore).

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default model (gemini-3.6-flash).
# MODEL_NAME=gemini-3.6-flash
