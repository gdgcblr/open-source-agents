# Environment Variable Configuration Template
# -----------------------------------------------------------------------------
# 1. Copy this file to '.env' in this directory: cp .env.example .env
# 2. Replace the placeholder values below with your own valid credentials.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# Optional: enables the Claude review pass. Without it, only static checks run.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the default Claude model
# MODEL_NAME=claude-sonnet-4-5-20250929
