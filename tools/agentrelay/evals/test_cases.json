    "id": "tc-review-01-security-risks",
    "category": "code_review",
    "description": "Verify deterministic detection of SQL injection, insecure deserialization, and missing tests.",
    "input_data": {
      "diff": "diff --git a/app.py b/app.py\n--- a/app.py\n+++ b/app.py\n@@ -1,3 +1,8 @@\n+import pickle\n+def run(user_input):\n+    query = f\"SELECT * FROM users WHERE name = '{user_input}'\"\n+    obj = pickle.loads(user_input)\n+    return query\n"
    },
    "expected": {
      "findings_contain": [
        "Unparameterized SQL Query",
        "Insecure Deserialization",
        "Production code modified without accompanying unit or integration tests"
      ]
    },
    "prohibited_claims": [
      "No security issues detected"
    ]
  },
  {
    "id": "tc-review-02-clean-diff",
    "category": "code_review",
    "description": "Verify clean diff with tests yields zero security findings and no false positives.",
