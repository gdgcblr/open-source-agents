# Environment Variable Configuration for AgentRelay
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' in tools/agentrelay: cp .env.example .env
# 2. AgentRelay runs 100% offline with zero external dependencies by default.
# 3. If enabling optional LLM semantic analysis, set AGENTRELAY_OFFLINE_MODE=false
#    and provide the required provider API key below.
# 4. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# --- Execution Mode ---
AGENTRELAY_OFFLINE_MODE=true
AGENTRELAY_MODEL_PROVIDER=offline

# --- Model & API Providers (Optional, used only when AGENTRELAY_OFFLINE_MODE=false) ---
# Google Gemini / Google AI Studio API Key
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative provider)
# OPENAI_API_KEY=your_openai_api_key_here

# --- Model Settings ---
AGENTRELAY_MODEL_NAME=gemini-2.5-flash
AGENTRELAY_MAX_TOKENS=2048
AGENTRELAY_TEMPERATURE=0.0
AGENTRELAY_REQUEST_TIMEOUT=15

# --- Application & Safety Settings ---
LOG_LEVEL=info
AGENTRELAY_REDACT_SECRETS=true
