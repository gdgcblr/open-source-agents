# =============================================================================
# CodeLens Doc Gen — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file. It is already in .gitignore.
# =============================================================================

# Google Gemini API Key (REQUIRED)
# Get your free API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-3.8-flash)
# Options: gemini-3.8-flash, gemini-flash-latest, gemini-pro-latest
GEMINI_MODEL=gemini-3.8-flash

# Output directory for generated documentation (default: ./docs_output)
OUTPUT_DIR=./docs_output

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum file size in bytes to analyze (default: 512KB)
# Files larger than this are skipped to avoid token limit issues
MAX_FILE_SIZE=524288
