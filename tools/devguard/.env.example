# DevGuard Environment Configuration
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' if using the AI commit-message feature:
#    cp .env.example .env
# 2. Add your Gemini API key below.
# 3. NEVER commit your actual '.env' file or keys to version control.
# -----------------------------------------------------------------------------

# Primary LLM API Key (optional for basic CLI, required for AI commit messages)
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier
GEMINI_MODEL=gemini-3.8-flash

