# Adapted from template/.env.example.
#
# The MCP SERVER requires no key and does not load environment files.
# The OPTIONAL Gemini manual client reads this configuration only when you
# explicitly run it with --env-file .env.local. Copy this file to .env.local
# and fill the key there, never here. .env.local is ignored by Git.
# Get a Gemini API key from https://aistudio.google.com/apikey
# Never add a real key, token, cookie, or database URL to a tracked file.
#
# Only for the optional manual client; keep the committed value empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
#
# Model-independent MCP server:
#   python -m pulseblr_events_mcp --source live
#   python -m pulseblr_events_mcp --source sample --now 2026-10-24T08:00:00+05:30
#
# Optional Gemini manual client:
#   python -m pulseblr_events_mcp.gemini_client --env-file .env.local --source sample
