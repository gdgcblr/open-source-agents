__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/

# Local output and logs
*.log
coverage.xml
junit.xml

# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
