# Environment Variable Configuration Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' in your project directory: cp .env.example .env
# 2. Replace the placeholder values below with your own valid credentials.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# Only needed for a real model run (--model gemini-3.8-flash).
# Offline runs (--model scripted:gullible) and `npm test` need nothing.
# Google AI Studio key. ADK reads GOOGLE_GENAI_API_KEY first, then GOOGLE_API_KEY,
# then GEMINI_API_KEY, so a GOOGLE_API_KEY already exported in your shell wins.
GEMINI_API_KEY=your_gemini_api_key_here

# Model for real runs; --model on the command line overrides it. With no .env,
# the tool runs offline with the scripted model. gemini-3.1-flash-lite is the
# model behind the README's real results; any gemini-* or gemma-* id works.
MODEL_NAME=gemini-3.1-flash-lite
