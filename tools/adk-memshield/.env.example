# adk-memshield environment configuration
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' in this directory: cp .env.example .env
# 2. Every variable is optional. The defaults below match the bundled
#    docker-compose.yml database (localhost:54329) and work as-is.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
#
# The library does not load '.env' by itself: export these variables in your
# shell, or pass the values to MemShieldConfig(...) directly. Inside the
# docker compose `test` service the DSNs are already set to the `db` host.
# -----------------------------------------------------------------------------

# --- Database (PostgreSQL 16 + pgvector) ---
# Non-superuser, NOBYPASSRLS role. MemShieldConfig.dsn defaults to this variable.
# Never point it at a superuser: superusers bypass Row-Level Security.
MEMSHIELD_DB_DSN=postgresql://memshield_app:memshield_pass@localhost:54329/memshield
# Admin role used only by tests/benchmarks/examples to seed and clean up rows.
MEMSHIELD_ADMIN_DSN=postgresql://postgres:postgres_admin_pass@localhost:54329/memshield

# --- Identity used by examples/quickstart.py ---
# In application code, pass these as MemShieldConfig(tenant_id=..., agent_clearance=...).
MEMSHIELD_TENANT_ID=acme_corp
# Clearance of the searching agent, 1..5.
MEMSHIELD_AGENT_CLEARANCE=1

# --- Embeddings ---
# FastEmbed ONNX model cache directory (the Docker image pre-warms this path).
# FASTEMBED_CACHE_PATH=/opt/fastembed_cache

# --- Optional: model provider for your own ADK agent ---
# adk-memshield itself calls no LLM; the tests use a mock model.
# GEMINI_API_KEY=your-gemini-api-key-here
