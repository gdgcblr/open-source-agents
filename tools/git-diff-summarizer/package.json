{
  "name": "git-diff-summarizer",
  "version": "0.1.0",
  "description": "A lightweight CLI tool that summarizes unstaged Git diffs using Google Gemini",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "git-diff-summarizer": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "keywords": [
    "git",
    "diff",
    "gemini",
    "summarizer",
    "developer-tools",
    "ai"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
