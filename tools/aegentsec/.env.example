# Copy to .env. Replace ADMIN_API_KEY with a long random value.
APP_NAME=AegentSec
APP_ENV=development
DATABASE_PATH=./data/aegentsec.sqlite3
IAM_ISSUER=http://localhost:8000
IAM_PRIVATE_KEY_PATH=./keys/private.pem
IAM_KEY_ID=aegentsec-key-001
JWT_EXPIRATION_MINUTES=15
ADMIN_API_KEY=replace-with-a-long-random-value
MCP_RESOURCE_URI=http://localhost:8000/mcp
INVENTORY_API_AUDIENCE=http://localhost:8001
