# RunReady eval — environment configuration template
# -----------------------------------------------------------------------------
# 1. Copy this file to `.env`:  cp .env.example .env
# 2. Set your Google AI Studio API key below.
# 3. NEVER commit your real `.env` — it is git-ignored.
#
# This eval is MODEL-BACKED: it runs Gemini to score diagnosis quality, so a key
# is required. (The agent's deterministic safety suite needs no key.)
# -----------------------------------------------------------------------------

# Required. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Use Google AI Studio (not Vertex AI).
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional: override the Gemini model the agent uses. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
