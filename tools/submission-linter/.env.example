# Only needed for the optional `--llm` review. Everything else works offline.

# Any OpenAI-compatible chat-completions endpoint. Default is a local Ollama server.
LLM_BASE_URL=http://localhost:11434/v1

# API key for the endpoint. Ollama ignores the value; hosted providers require a real key.
LLM_API_KEY=your-api-key-here

# Model name understood by the endpoint.
LLM_MODEL=llama3.1
