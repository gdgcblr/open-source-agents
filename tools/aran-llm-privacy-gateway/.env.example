# Aran - environment configuration (all optional; no API keys needed)
# -----------------------------------------------------------------------------
# Aran runs fully locally. It reads these from the process environment: export them
# in your shell, or set them in your MCP client's server config. NEVER commit a real '.env'.
# -----------------------------------------------------------------------------

# Local model served by Ollama, used for names/addresses and reading scans.
# ARAN_LOCAL_MODEL=gemma4:12b
# OLLAMA_HOST=http://localhost:11434

# Where the token vault and audit log live (created with owner-only permissions).
# ARAN_HOME=~/.aran

# MCP server only: the folder whose documents agents may read, and the vault session
# chosen by the host process (agents cannot pick their own).
# ARAN_DOCS_DIR=./samples/kyc
# ARAN_SESSION_ID=s_0123456789ab
