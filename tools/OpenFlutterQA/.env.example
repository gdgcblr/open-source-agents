# Environment Variable Configuration Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' in your project directory: cp .env.example .env
# 2. Replace the placeholder values below with your own valid credentials.
# 3. NEVER commit your actual '.env' file or any real secrets to Git.
# -----------------------------------------------------------------------------

# --- Model & API Providers ---
# Optional: Google Gemini API Key for AI test generation and step refinement.
# If omitted or set to placeholder, OpenFlutterQA automatically falls back to
# its built-in deterministic Mock AI Provider so all features work offline.
GEMINI_API_KEY=AIzaSyDiogI9S2ATTRkmFwHiM6CPwv0NFGYrVuw

# --- Model Settings ---
MODEL_NAME=gemini-2.5-flash
TEMPERATURE=0.3

# --- Device Cloud / Execution Settings (Optional) ---
DEVICE_SOURCE=LambdaTest
DEFAULT_DEVICE=iPhone 14, Pixel 8 Pro
TARGET_HOST=Staging_v2.4
LOG_LEVEL=info
